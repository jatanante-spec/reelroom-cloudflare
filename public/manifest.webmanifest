{
  "name": "ReelRoom — your video wall",
  "short_name": "ReelRoom",
  "description": "Your saved YouTube, TikTok, Instagram and Facebook links in one browsable wall. Embed only — nothing is downloaded.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f0f0f",
  "theme_color": "#0f0f0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["entertainment", "photo", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    {
      "name": "Add links",
      "short_name": "Add",
      "description": "Paste new video links",
      "url": "/?add=1"
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "description": "Jump to your favorites",
      "url": "/?view=favorites"
    }
  ]
}
