# OPTIONAL — only needed if you want to run the app on your own computer.
# Production settings live in the Cloudflare dashboard, not in this file.
# To use locally: copy to wrangler.toml and paste your real database_id.
name = "reelroom"
compatibility_date = "2026-11-01"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "DB"
database_name = "reelroom"
database_id = "PASTE-YOUR-DATABASE-ID-HERE"
